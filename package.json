{
  "name": "@commonkads/provider-google",
  "version": "0.1.0",
  "description": "Google Gemini provider implementation for the CommonKADS engine",
  "type": "module",
  "author": "Rob Proper",
  "license": "Apache-2.0",
  "engines": { "node": ">=24" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "precompile": "npm run lint:fix",
    "compile": "tsc --build && tsc --noEmit -p tsconfig.test.json",
    "format": "prettier \"./**/*.ts\" --write",
    "lint:fix": "npm run lint -- --fix",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "postlint": "npm run format",
    "release": "changeset publish"
  },
  "dependencies": {
    "@commonkads/engine": "^0.1.0",
    "@google/genai": "^2.31.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
